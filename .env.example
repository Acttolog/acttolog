# ═══ ACTTOLOG environment template ═══
# Copy to .env (never commit .env). All integrations degrade gracefully
# to honest "Not Configured" states when absent (Admin → Integrations).

# ── Database (PostgreSQL / Supabase) ─────────────────────────────
# Without it the site runs on bundled seed content; with it, CMS + analytics persist.
DATABASE_URL=

# ── Session signing ───────────────────────────────────────────────
# REQUIRED in production. Generate: openssl rand -base64 32
AUTH_SECRET=

# ── Google OAuth (Continue with Google) ──────────────────────────
# Console → APIs & Services → Credentials → OAuth client (Web application)
# Authorized redirect URI: https://www.acttolog.com/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Roles (server-side only — never exposed publicly) ────────────
# The Owner email is private and must never render in the UI (spec §5, §45).
OWNER_EMAIL=
ADMIN_EMAILS=

# ── OpenAI (Acttolog AI — server-side only) ──────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Google Analytics 4 (loaded only after analytics consent) ─────
NEXT_PUBLIC_GA_ID=

# ── Google Drive backups (private; weekly, indefinite retention) ─
GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=
GOOGLE_DRIVE_BACKUP_FOLDER_ID=

# ── Object storage (S3-compatible; media uploads) ────────────────
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── Email provider (contact notifications — future) ──────────────
SMTP_URL=

# ── Payments (modular adapters; disabled until authorized) ───────
PAYMENT_PROVIDER=
PAYMENT_SECRET_KEY=

# ── Site ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.acttolog.com
