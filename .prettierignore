# Build output and stale export artifacts — never format these.
# Prettier rewriting hashed chunks under _next/ changes bytes whose hash is in
# the filename, and churning 300 generated files buries real diffs.
.next/
_next/
.static-build/
.pages-site/
out/
node_modules/
coverage/

