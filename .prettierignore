/admin/
/darkroom/
/my/
/offers/
/blog/
/entertainment/
/academy/
/games/
/*.html
/*.rsc
/*.meta
/*.segments
.shots/

# Vendored third-party bundles (Leaflet). Reformatting a minified file inflates
# it and diverges from upstream for no benefit.
**/vendor/
